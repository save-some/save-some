# Copy to backend/.env and fill in. Values are read by api/utils.py (and the
# seed scripts) through python-dotenv; nothing here is a real credential.
#
# Database — either one works, DATABASE_URL wins when both are set:
#   - DATABASE_URL: a full postgres URI. Use this for a local cluster, or for
#     Supabase through its IPv4 pooler (username "postgres.<project-ref>").
#   - or the five DB_* parts below (they template into the URI).
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_PROJECT_ID=
DB_PORT=5432
DB_NAME=postgres

# Only needed by seed/seed.py (RapidAPI product ingestion) — the API itself
# runs without these.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RAPIDAPI_KEY=
