# Copy to .env. Every value here is optional for local UI development.
#
# The app degrades gracefully when these are absent: it skips Supabase
# initialisation, signs you in as DEV_USER_ID, and reads product data from the
# REST API instead. Fill them in when you want real authentication.
#
# Note pubspec.yaml declares .env as a bundled asset, so the file must exist for
# the build to succeed even if it is entirely commented out.

# Supabase project credentials, from Project Settings -> API.
# Use the anon/publishable key here, never the service_role key — this file is
# compiled into the app bundle and is readable by anyone who downloads it.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Mapbox public access token, from account.mapbox.com.
# Without it the Maps tab renders but tiles never load. Mapbox has no web
# support at all, so on Chrome the map is replaced by a placeholder regardless.
MAPBOX_TOKEN=
